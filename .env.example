# Security Warning: Keep your SECRET_KEY secret in production!
SECRET_KEY=generate_a_strong_secret_key_here

# Set to False in production
DEBUG=True

# Allowed hosts (comma separated, no spaces)
# Example for Vercel: your-app.vercel.app
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Supabase PostgreSQL URL)
# Example: postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Leave this blank or comment it out to use local SQLite database
# DATABASE_URL=
